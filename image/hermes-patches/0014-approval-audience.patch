+def session_has_no_audience(session_id: str) -> bool:
+    """True when a plugin's ``approval_audience`` hook answers ``"none"`` for *session_id*: nobody
+    watches that session, so a prompt raised there can only time out. Every /v1/runs run registers
+    a notifier, so on api_server only the host knows which runs are a person's chat."""
+    from hermes_cli.lifecycle import has_hook, invoke_hook
+    return has_hook("approval_audience") and "none" in invoke_hook("approval_audience", session_id=session_id)
+
