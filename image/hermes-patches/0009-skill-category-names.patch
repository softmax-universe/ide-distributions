+def _category_dot_readings(name: str, all_dirs) -> list[str]:
+    """Skill paths that ``<category>.<name>`` can mean, where the category may nest
+    (``a.b.c`` reads as ``a/b.c`` or ``a/b/c``): only those with a ``SKILL.md`` in some root."""
+    parts = name.split(".")
+    if "" in parts:
+        return []
+    readings = ("/".join(parts[:i]) + "/" + ".".join(parts[i:]) for i in range(1, len(parts)))
+    return sorted({path for path in readings if any((Path(d) / path / "SKILL.md").is_file() for d in all_dirs)})
+
