+            lines = _strip_terminal_fence_leaks(probe.stdout).strip().split("\n") if probe.exit_code == 0 else []
+            if lines and lines[0] and lines[0] != dir_path:
+                listing = ", ".join(line for line in lines[1:] if line) or "nothing"
+                return ReadResult(
+                    error=f"File not found: {path}", not_found=True,
+                    hint=f"No directory {dir_path}. The nearest existing one is {lines[0]}, holding: {listing}")
         scored.sort(key=lambda x: -x[0])
         return ReadResult(error=f"File not found: {path}", not_found=True,
                           similar_files=[fp for _, fp in scored[:5]])
