--- a/tools/file_operations.py
+++ b/tools/file_operations.py
@@ -1244,6 +1244,19 @@ class ShellFileOperations(LintMixin, SearchMixin, FileOperations):
                     score = 50
                 if score > 0:
                     scored.append((score, os.path.join(dir_path, f)))
+        else:
+            # The directory itself is missing: name the deepest one that exists and what it holds,
+            # so a wrong folder in the path is fixed in one step rather than by guessing again.
+            probe = self._exec(
+                f"d={self._escape_shell_arg(dir_path)}; "
+                'while [ ! -d "$d" ] && [ "$d" != / ] && [ "$d" != . ]; do d=$(dirname "$d"); done; '
