             api_msg[RD] = private
 
 
+def normalize_reasoning_replay_keep_last(value: Any) -> int | None:
+    """``agent.reasoning_replay_keep_last``: a positive int, or None (off: replay every turn's reasoning)."""
+    if value is None or isinstance(value, bool):
+        return None
+    try:
+        keep = int(value)
+    except (TypeError, ValueError):
+        return None
+    return keep if keep > 0 else None
+
+
+def reasoning_replay_withheld(messages: list, keep_last: int | None) -> set[int]:
+    """Indices of assistant messages whose stored reasoning is NOT replayed under ``keep_last``.
+
+    The newest ``keep_last`` assistant messages always keep their reasoning. Older ones lose it in
+    blocks of ``keep_last``: the boundary moves only when another ``keep_last`` assistant messages
+    have been added, so the wire prefix changes once per block (one prompt-cache break) instead of
+    on every call. Between ``keep_last`` and ``2 * keep_last - 1`` messages keep their reasoning.
+    """
+    if keep_last is None:
+        return set()
+    assistants = [i for i, m in enumerate(messages) if isinstance(m, dict) and m.get("role") == "assistant"]
+    boundary = max(0, (len(assistants) - keep_last) // keep_last * keep_last)
+    return set(assistants[:boundary])
+
+
+def withhold_replayed_reasoning(source_msg: dict, api_msg: dict, needs_thinking_pad: bool, carriers: frozenset) -> None:
+    """Shape ``api_msg`` as if ``source_msg`` had no stored reasoning: every carrier is removed, and a
+    must-echo route keeps its " " pad (``apply_reasoning_content_policy``)."""
+    for key in REASONING_CARRIERS:
+        api_msg.pop(key, None)
+    bare = {key: value for key, value in source_msg.items() if key not in REASONING_CARRIERS}
+    apply_reasoning_content_policy(bare, api_msg, needs_thinking_pad, carriers)
+
+
 def _reasoning_shape(msg: dict) -> tuple:
     return tuple(msg.get(key) for key in REASONING_CARRIERS)
 
